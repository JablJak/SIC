@Inbook{Taubman2002,
	author="Taubman, David S.
	and Marcellin, Michael W.",
	title="Introduction to JPEG2000",
	bookTitle="JPEG2000 Image Compression Fundamentals, Standards and Practice",
	year="2002",
	publisher="Springer US",
	address="Boston, MA",
	pages="399--415",
	abstract="At the time of this writing, JPEG2000 is the newest international standard for still image compression. The JPEG acronym stands for ``Joint Photographic Experts Group.'' The ``Joint'' here signifies that JPEG2000 is published as an ISO/IEC standard, as well as an ITU-T Recommendation. The acronyms of the previous sentence stand for International Organization for Standardization/International Electrotechnical Commission, and International Telecommunications Union-Terminal Sector,1 respectively. The Joint Bi-level Imagery Experts Group (JBIG) has often worked closely together with the JPEG committee. In fact, the two committees typically meet in the same venues.",
	isbn="978-1-4615-0799-4",
	doi="10.1007/978-1-4615-0799-4_9",
	url="https://doi.org/10.1007/978-1-4615-0799-4_9"
}

@inbook{doi:https://doi.org/10.1002/9781118711743.ch3,
	publisher = {John Wiley & Sons, Ltd},
	isbn = {9781118711743},
	title = {A History of Video Coding and Video Coding Standards},
	booktitle = {Coding Video},
	chapter = {3},
	pages = {43-68},
	doi = {https://doi.org/10.1002/9781118711743.ch3},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/9781118711743.ch3},
	eprint = {https://onlinelibrary.wiley.com/doi/pdf/10.1002/9781118711743.ch3},
	year = {2024},
	keywords = {bitstream format, digital video usage, mass-market applications, video coding, video coding standards},
	abstract = {Summary This chapter traces the development of video coding from the early theoretical concepts, many of which were first proposed in the 1970s and 1980s, through the first industry standards, the emergence of mass-market applications, the rise of internet and mobile video, to the present day. It looks at when and how were the early concepts of video coding developed? and how did these concepts evolve into the well-known block-based video codec model? A video coding standard specifies a bitstream format for compressed video and a method of decoding the bitstream to produce a decoded video sequence. H.261 was the first of the industry standards for video coding to have an appreciable commercial impact. The chapter also looks at how did the video coding standards contribute to or influence the changing patterns of digital video usage, from television and DVDs to video streaming?}
}

